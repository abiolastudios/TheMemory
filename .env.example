# Copy this file to .env.local and fill in the values.

# Postgres connection string. Add ?sslmode=require if your host needs SSL (most hosted ones do).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Cloudflare R2
# Account ID: Cloudflare dashboard → R2 (shown on the right-hand side)
# Keys: R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=proposal-moments
# Public address of the bucket: either the r2.dev URL (bucket → Settings → Public access)
# or a custom domain you attached, e.g. https://photos.yourdomain.com
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Password for the /admin page
ADMIN_PASSWORD=choose-a-strong-password

